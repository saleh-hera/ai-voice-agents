# Copy this file to ".env" and paste your real Vapi API key.
# Get it from https://dashboard.vapi.ai  ->  Settings  ->  API Keys
VAPI_API_KEY=your_vapi_api_key_here

# Used by sync_to_stripe.py. Get it from https://dashboard.stripe.com/apikeys
# Use a sk_test_... key first to dry-run against Stripe's test mode before
# ever pointing this at sk_live_...
STRIPE_SECRET_KEY=your_stripe_secret_key_here
