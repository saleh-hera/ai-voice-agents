# Copy this file to .env and fill in real values. Never commit .env.

# Database (SQLite file by default — fine until you outgrow it)
DATABASE_URL=sqlite:///./dealer_engine.db

# Twilio — used for missed-call recovery, reminders, review requests
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Owner notification email (replaces n8n's "ping me on Slack" step)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM_EMAIL=
NOTIFY_TO_EMAIL=

# Shared secret Vapi must send back so /webhook/vapi can't be spoofed
VAPI_WEBHOOK_SECRET=
